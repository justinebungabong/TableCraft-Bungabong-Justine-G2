# Copy this file to .env and replace the placeholders. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgres://user:password@host:5432/tablecraft

# ISS-03: customer ordering stays disabled until the PD4 lifecycle exists.
# Set to True only once payment, kitchen and status transitions are shipped.
ORDERING_ENABLED=False
